     /Pg 2653 0 R
     /Type /StructElem
  >>
endobj

2772 0 obj
  << /ActualText (B\056 Tujuan Lomba\nPenyelenggaraan kompetisi ini bertujuan untuk menjadi sarana pengembangan kompetensi mahasiswa dalam penguasaan teknologi web yang relevan dan berdampak langsung di kehidupan saat ini\056 Peserta diharapkan mampu memanfaatkan\240 keahlian teknis dengan pemahaman mendalam terhadap berbagai isu yang ada agar dapat menghasilkan solusi digital yang tepat guna bagi masyarakat luas\056 Selain itu\054 ajang ini juga menjadi wadah strategis untuk memupuk semangat profesionalisme serta mendorong implementasi nyata dari disiplin ilmu yang ditekuni\054 sekaligus menjadi sarana kolaborasi kreatif untuk menyemarakkan momentum perayaan JKB Festival 2026\056)
     /K [ 4 ]
     /P 2773 0 R
     /Pg 2653 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

